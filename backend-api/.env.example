PORT=5000

# MongoDB Atlas Cloud Database Connection String
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/chatapp?retryWrites=true&w=majority

# Resend.com API Key (Optional: For cloud email OTP delivery)
RESEND_API_KEY=re_your_resend_api_key_here

# Gmail SMTP Settings (Optional: For free real email OTP delivery)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_digit_app_password
